exports[`seed-stability — grade-4 lesson-derived generator output is pinned byte-for-byte note_value_compare @ rhythm-breve-4 instances are a pure function of (template, grade, seed, atoms) 1`] = `
[
  {
    "answer": {
      "accepted_alternatives": [],
      "canonical": "The open one (minim)",
    },
    "distractors": [
      "The filled one with a flag (quaver)",
    ],
    "feedback": {
      "correct": "A minim lasts 2 beats; a quaver lasts half a beat — so the minim lasts longer.",
      "incorrect": "Not quite — compare how long each note is held, not how it looks on the page.",
    },
    "grade": 4,
    "hints": [],
    "id": "note_value_compare:g4:s0",
    "interaction": {
      "config": {},
      "type": "mcq",
    },
    "kb_version": "g1-2026-07-10",
    "prompt": "Which note lasts longer?",
    "srs_tags": [
      "note_value_compare",
    ],
    "stimulus": {
      "music": {
        "clef": "bass",
        "key_sig": null,
        "time_sig": null,
        "voices": [
          {
            "events": [
              {
                "dur": "quaver",
                "pitch": "A2",
                "type": "note",
              },
              {
                "dur": "minim",
                "pitch": "A2",
                "type": "note",
              },
            ],
          },
        ],
      },
      "text": null,
    },
    "strand": "rhythm",
    "template_id": "note_value_compare",
  },
  {
    "answer": {
      "accepted_alternatives": [],
      "canonical": "The open one with a line either side (breve)",
    },
    "distractors": [
      "The filled one (crotchet)",
    ],
    "feedback": {
      "correct": "A breve lasts 8 beats; a crotchet lasts 1 beat — so the breve lasts longer.",
      "incorrect": "Not quite — compare how long each note is held, not how it looks on the page.",
    },
    "grade": 4,
    "hints": [],
