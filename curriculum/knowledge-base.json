      "minors": {
        "A": 0, "E": 1, "B": 2, "F#": 3, "C#": 4, "G#": 5, "D#": 6,
        "D": -1, "G": -2, "C": -3, "F": -4, "Bb": -5, "Eb": -6
      },
      "relative_rule": "relative minor tonic = major tonic minus a minor 3rd; same key signature"
