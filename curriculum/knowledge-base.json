      "4/4": {"beat_unit": "crotchet", "beam_within_beats": true, "quaver_pair_rule": "may beam beats 1-2 or 3-4 together; never across the middle of the bar"},
      "2/2 3/2 4/2": {"beat_unit": "minim", "beam_within_beats": true},
      "3/8": {"beat_unit": "quaver (or dotted-crotchet bar)", "beam_within_beats": true},
      "6/8 9/8 12/8": {"beat_unit": "dotted crotchet", "beam_within_beats": true, "rest_rule": "show each dotted-crotchet beat; whole-beat rest = crotchet rest + quaver rest or dotted-crotchet rest per house style"},
      "5/4 7/4": {"beat_unit": "crotchet", "grouping": "show subdivision 2+3 / 3+2 / 3+4 / 4+3 etc.", "grade": 5}
