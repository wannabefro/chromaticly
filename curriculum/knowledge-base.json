      "modification_rules": "major -1 semitone = minor; minor -1 = diminished; major +1 = augmented; perfect -1 = diminished; perfect +1 = augmented",
      "compound_rule": "interval > octave; name = simple name + 7 (e.g. compound major 2nd = major 9th)"
    },
    "beaming_rules_by_time_signature": {
      "2/4": {"beat_unit": "crotchet", "beam_within_beats": true, "quaver_full_bar_beam": "allowed as one group of 4"},
